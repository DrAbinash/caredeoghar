# The format of this file is identical to `.dockerignore`.
# It is used to reduce the size of deployed images to make the process of publishing faster.
# Replit deployments use THIS file, not .dockerignore.

# Replit local cache (pnpm store, agent state, etc.)
.local
.cache

# Version control
.git
.github

# IDE / editor
.idea
.vscode
.cursor

# Build outputs that the deploy image rebuilds itself
**/node_modules
**/dist
**/.turbo
**/.expo
**/.expo-shared
**/.replit-artifact
**/*.tsbuildinfo

# Logs and tmp
*.log
tmp
/tmp

# Environment files (secrets come from Replit Secrets, not files)
.env
.env.*

# Local archive bundles
project.tar.gz
project.zip

# Screenshots / attached assets
attached_assets/screenshots

# Documentation that isn't needed at runtime
README-WINDOWS.md
DEPLOY.md
replit.md

# === HEAVY: Windows offline distributables (4 GB+) ===
# These are end-user installer zips/exes for on-prem Windows deployments.
# The cloud deployment runs the same source code directly and does NOT need them.
windows-build/dist
windows-build/.cache
windows-build/payload-cache
windows-build/node_modules
windows-build/dist/payload
windows-build/dist/portable
windows-build/dist/electron

# Mockup sandbox is a dev-only design tool, not a production artifact
artifacts/mockup-sandbox

# Test outputs
**/playwright-report
**/test-results
**/coverage
