{
  "name": "care-diagnostics-windows",
  "version": "1.0.0",
  "description": "Care Diagnostics Desktop App for Windows",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:portable": "electron-builder --win portable",
    "dist": "npm run build:win"
  },
  "build": {
    "appId": "com.carediagnostics.desktop",
    "productName": "Care Diagnostics",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "static-build/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "ia32"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "static-build/assets/images/icon.png",
      "publisherName": "Care Diagnostics"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Care Diagnostics",
      "uninstallDisplayName": "Care Diagnostics",
      "include": "",
      "license": "",
      "installerIcon": "static-build/assets/images/icon.png",
      "uninstallerIcon": "static-build/assets/images/icon.png"
    },
    "portable": {
      "artifactName": "CareDiagnostics-Portable-${version}.exe"
    }
  },
  "dependencies": {
    "electron": "^35.0.0"
  },
  "devDependencies": {
    "electron-builder": "^26.0.0"
  }
}
