{
  "name": "@workspace/diagnostic-erp-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Native Windows desktop app for the Diagnostic Center Billing ERP.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^39.8.5",
    "electron-builder": "^26.0.0"
  },
  "overrides": {
    "tar": "^7.4.3",
    "@tootallnate/once": "npm:@tootallnate/once@^3.0.1"
  },
  "build": {
    "appId": "com.diagnosticerp.desktop",
    "productName": "DiagnoCenter Desktop",
    "directories": {
      "output": "../dist/electron"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist/payload",
        "to": "payload",
        "filter": ["**/*"]
      }
    ],
    "asar": true,
    "compression": "store",
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "artifactName": "DiagnoCenter-Desktop-Setup-${version}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DiagnoCenter Desktop"
    }
  }
}
