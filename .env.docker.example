# Copy this file to ".env" in the same folder as docker-compose.yml.
# All values shown below are the defaults — override only what you need.

# Host port that nginx will listen on. Open http://localhost:<HOST_PORT>
HOST_PORT=8888

# Database settings (used both by Postgres and by the api service)
# ⚠️ CHANGE DB_PASSWORD before going to production. Patient data lives in this DB.
DB_USER=erp
DB_PASSWORD=changeme
DB_NAME=diagnostic_erp

# API server log verbosity: trace | debug | info | warn | error
LOG_LEVEL=info

# Optional: Google Gemini AI for the /api/ai routes
# AI_INTEGRATIONS_GEMINI_API_KEY=

# Optional: PACS / Orthanc integration
# ORTHANC_URL=
# ORTHANC_USERNAME=
# ORTHANC_PASSWORD=
# OHIF_URL=

# Optional: shared secret for the fingerprint bridge service
# FINGERPRINT_BRIDGE_SECRET=
