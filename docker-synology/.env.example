# =============================================================================
# Care Diagnostics Environment Settings for Synology NAS
#
# Copy this file to ".env" in the same folder:
#   cp .env.example .env
#
# Then edit the values below. Only change what you need.
# =============================================================================

# Port you will open in your browser (e.g., http://nas-ip:8888)
HOST_PORT=8888

# Database login. CHANGE THE PASSWORD before going live.
DB_USER=erp
DB_PASSWORD=changeme
DB_NAME=diagnostic_erp

# How much the API server logs: trace | debug | info | warn | error
LOG_LEVEL=info

# --- Optional integrations (uncomment and fill to enable) ---

# Google Gemini AI for report generation, billing insights
# AI_INTEGRATIONS_GEMINI_API_KEY=
# AI_INTEGRATIONS_GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# PACS / DICOM integration (Orthanc)
# ORTHANC_URL=
# ORTHANC_USERNAME=
# ORTHANC_PASSWORD=
# OHIF_URL=

# Fingerprint kiosk bridge shared secret
# FINGERPRINT_BRIDGE_SECRET=

# Super Admin USB pen-drive gate (compliance access)
# SUPER_ADMIN_USB_KEY=
