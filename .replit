modules = ["nodejs-24"]

[[artifacts]]
id = "3B4_FFSkEVBkAeYMFRJ2e"
run = "node --enable-source-maps artifacts/api-server/dist/index.mjs"
buildCommand = "pnpm --filter @workspace/api-server run build"
localPort = 8080


[deployment]
router = "application"
deploymentTarget = "reserved"
run = "node --enable-source-maps artifacts/api-server/dist/index.mjs"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000
