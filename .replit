modules = ["nodejs-24", "postgresql-16", "python-3.11"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/diagnostic-erp"

[[artifacts]]
id = "artifacts/super-admin-portal"

[[artifacts]]
id = "artifacts/clinic-site"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Windows Build"

[[workflows.workflow]]
name = "Windows Build"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "rm -f /tmp/wb-logs/done.flag && mkdir -p /tmp/wb-logs && pnpm -C windows-build run build:all 2>&1 | tee /tmp/wb-logs/build-all.log && pnpm -C windows-build run build:super-admin 2>&1 | tee /tmp/wb-logs/build-sa.log && date -Iseconds > /tmp/wb-logs/done.flag && echo BUILD_COMPLETE"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
