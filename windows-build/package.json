{
  "name": "@workspace/windows-build",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Build Windows .exe distributions of the Diagnostic Center Billing ERP (portable launcher, NSIS installer, Electron desktop app).",
  "scripts": {
    "build:payload": "node scripts/build-payload.mjs",
    "build:launcher": "node scripts/build-launcher.mjs",
    "build:portable": "node scripts/build-portable-zip.mjs",
    "build:installer": "node scripts/build-installer.mjs",
    "build:electron": "node scripts/build-electron.mjs",
    "build:super-admin": "node scripts/build-super-admin.mjs",
    "build:update-zip": "node scripts/build-update-zip.mjs",
    "build:all": "node scripts/build-all.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  }
}
