# ─── ERP Connection ───────────────────────────────────────────────────────────
# URL of the ERP API (production or local dev)
ERP_BASE_URL=https://your-erp-domain.replit.app

# Internal API key (must match INTERNAL_API_KEY secret in ERP)
INTERNAL_API_KEY=your_internal_api_key_here

# Set to 0 to disable remote config fetch (use local .env / last-known-good only)
ERP_CONFIG_ENABLED=1

# ─── Agent Identity ───────────────────────────────────────────────────────────
# Unique identifier for this agent instance (shown in ERP Agent Monitor)
AGENT_ID=agent-deoghar-01

# AE Title for this pull agent (used as the calling AE in C-FIND/C-MOVE)
LOCAL_AE_TITLE=DIAGNO_AGENT

# ─── Conquest PACS (fallback if ERP unreachable) ─────────────────────────────
CONQUEST_HOST=127.0.0.1
CONQUEST_PORT=5678
CONQUEST_AE=CONQUEST1

# ─── Polling ─────────────────────────────────────────────────────────────────
# How often to poll each modality (milliseconds). Default: 300000 (5 min)
DEFAULT_POLLING_INTERVAL_MS=300000

# Maximum retry attempts for failed retrievals
MAX_RETRIES=5

# ─── Advanced ─────────────────────────────────────────────────────────────────
# NODE_ENV=production
