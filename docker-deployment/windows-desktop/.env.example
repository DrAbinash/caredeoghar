# =============================================================================
# Care Diagnostics ERP — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your real values:
#   copy .env.example .env
#
# NEVER commit .env to version control — it contains secrets!
# =============================================================================

# ── Database ───────────────────────────────────────────────────────────────
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_PASSWORD
DB_NAME=HospERP

# Example DATABASE_URL (used internally by docker-compose):
# postgresql://postgres:CHANGE_ME_PASSWORD@postgres:5432/HospERP

# ── Session Security ─────────────────────────────────────────────────────────
# Generate a random 64+ character string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-long-string-at-least-64-characters

# ── AI Integration (Gemini) — Optional ─────────────────────────────────────
# Required for AI-powered clinical notes, billing insights, report drafting.
# Get a free API key from: https://aistudio.google.com/app/apikey
# AI_INTEGRATIONS_GEMINI_API_KEY=your-gemini-api-key-here
# AI_INTEGRATIONS_GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# ── Email Notifications — Optional ─────────────────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# ── Object Storage — Optional ──────────────────────────────────────────────
# For persistent file uploads (reports, patient photos, DICOM)
# DEFAULT_OBJECT_STORAGE_BUCKET_ID=your-bucket-id
# PRIVATE_OBJECT_DIR=/data/private
# PUBLIC_OBJECT_SEARCH_PATHS=/data/public

# ── Super Admin USB Key — Optional ─────────────────────────────────────────
# Content of superadmin.key file on the USB pen-drive.
# Leave empty to disable the USB gate (not recommended for production).
# SUPER_ADMIN_USB_KEY=your-secret-key-content

# ── PACS / DICOM — Optional ────────────────────────────────────────────────
# CONQUEST_HOST=192.168.1.100
# CONQUEST_PORT=5678

# ── Bill Print Defaults ────────────────────────────────────────────────────
# BILL_PRINT_COPIES=2
# BILL_DEFAULT_PAPER_SIZE=A5
