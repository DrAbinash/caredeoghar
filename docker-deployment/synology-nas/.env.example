# =============================================================================
# Care Diagnostics ERP — Synology NAS Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your real values before deploying.
#
# Set these in Synology Container Manager when creating the project,
# or create a .env file in the same folder as docker-compose.yml.
# =============================================================================

# ── Database ───────────────────────────────────────────────────────────────
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_PASSWORD
DB_NAME=HospERP

# ── Session Security ─────────────────────────────────────────────────────────
# Generate a random string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-long-string-at-least-64-characters

# ── AI Integration (Gemini) — Optional ─────────────────────────────────────
# AI_INTEGRATIONS_GEMINI_API_KEY=your-gemini-api-key-here
# AI_INTEGRATIONS_GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# ── Email Notifications — Optional ─────────────────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# ── Object Storage — Optional ──────────────────────────────────────────────
# DEFAULT_OBJECT_STORAGE_BUCKET_ID=your-bucket-id
# PRIVATE_OBJECT_DIR=/data/private
# PUBLIC_OBJECT_SEARCH_PATHS=/data/public

# ── Super Admin USB Key — Optional ─────────────────────────────────────────
# SUPER_ADMIN_USB_KEY=your-secret-key-content

# ── ICICI Orange PG — Optional ─────────────────────────────────────────────
# ICICI_MERCHANT_ID=your-icici-merchant-id
# ICICI_AGGREGATOR_ID=your-icici-aggregator-id
# ICICI_SECRET_KEY=your-icici-secret-key

# ── PACS / DICOM — Optional ────────────────────────────────────────────────
# CONQUEST_HOST=192.168.1.100
# CONQUEST_PORT=5678
