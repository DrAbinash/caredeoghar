# Copy this file to .env and fill in the values for local (Windows/macOS/Linux) development.
# On Replit these values are provided automatically by the platform; the .env file is
# only needed when running outside Replit.

# --- REQUIRED ------------------------------------------------------------

# Postgres connection string. Install Postgres locally (https://www.postgresql.org/download/)
# create a database, then point this URL at it.
# Example for a local Postgres:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/diagnostic_erp

# --- OPTIONAL (only set if you use the corresponding feature) ------------

# Service ports. If unset the apps fall back to:
#   API server         8080
#   Diagnostic ERP web 5173
#   Super-Admin portal 5174
# PORT=

# Base path for the web frontends (defaults: "/" and "/super-admin-portal/").
# BASE_PATH=

# Logging level for the API server (default: info)
# LOG_LEVEL=info

# Gemini AI integration (used by /api/ai routes)
# AI_INTEGRATIONS_GEMINI_API_KEY=
# AI_INTEGRATIONS_GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# PACS / Orthanc integration (used by /api/pacs routes)
# ORTHANC_URL=
# ORTHANC_USERNAME=
# ORTHANC_PASSWORD=
# PACS_VIEWER_TYPE=weasis
# OHIF_URL=
# WADO_URL=

# Fingerprint bridge service shared secret
# FINGERPRINT_BRIDGE_SECRET=
